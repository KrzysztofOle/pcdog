[Unit]
Description=PcDog read-only GPIO hardware agent
Documentation=https://github.com/KrzysztofOle/pcdog
After=local-fs.target

[Service]
Type=simple
User=root
Group=pcdog
ExecStart=/opt/pcdog/bin/pcdog-hardware-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pcdog-hardware-agent
NoNewPrivileges=yes
PrivateDevices=no
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RuntimeDirectory=pcdog-hardware-agent
RuntimeDirectoryMode=0750
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
DevicePolicy=closed
# Linux GPIO character-device requires O_RDWR even when gpioget requests an
# input line. The agent code exposes only the fixed GPIO19/GPIO20 input read.
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
